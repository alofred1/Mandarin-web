{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "false" }
    },
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com') || root.child('teachers').child(auth.uid).exists())"
      }
    },
    "teachers": {
      ".read": "auth != null && ((root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com') || root.child('teachers').child(auth.uid).exists())",
      "$uid": { ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com')" }
    },
    "tasks": {
      ".read": "auth != null",
      "$taskId": { ".write": "auth != null && root.child('teachers').child(auth.uid).exists()" }
    },
    "submissions": {
      "$taskId": {
        ".read": "auth != null && (root.child('teachers').child(auth.uid).exists() || (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com'))",
        "$uid": { ".write": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists() || (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com'))" }
      }
    },
    "notifications": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists() || (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com'))" }
    },
    "chats": {
      "$channel": { ".read": "auth != null", ".write": "auth != null" },
      "private": { "$uid1": { "$uid2": { ".read": "auth != null && (auth.uid === $uid1 || auth.uid === $uid2)", ".write": "auth != null && (auth.uid === $uid1 || auth.uid === $uid2)" } } }
    },
    "practiceResults": {
      "$uid": { ".write": "auth != null && auth.uid === $uid", ".read": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists() || (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'alfredadmin@users.alfredmandarin.firebaseapp.com'))" }
    },
    "voiceRooms": { ".read": "auth != null", ".write": "auth != null" },
    "voiceSignals": { ".read": "auth != null", ".write": "auth != null" }
  }
}
